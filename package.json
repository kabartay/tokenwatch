{
  "name": "tokenwatch",
  "displayName": "Tokenwatch",
  "description": "Claude Code session and weekly usage quota, live in the VS Code status bar.",
  "version": "0.2.1",
  "publisher": "kabartay",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kabartay/tokenwatch.git"
  },
  "bugs": {
    "url": "https://github.com/kabartay/tokenwatch/issues"
  },
  "homepage": "https://github.com/kabartay/tokenwatch#readme",
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "quota",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenwatch.refresh",
        "title": "Refresh Claude Usage",
        "category": "Tokenwatch",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenwatch.showLog",
        "title": "Show Log",
        "category": "Tokenwatch",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Tokenwatch",
      "properties": {
        "tokenwatch.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "markdownDescription": "Seconds between automatic refreshes. Windows that are not focused skip polls and catch up when focused."
        },
        "tokenwatch.warnThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "The status bar turns amber when either quota reaches this percentage (and red at 100%)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package",
    "vscode:prepublish": "rm -rf out && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}

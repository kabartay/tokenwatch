{
  "name": "tokenwatch",
  "displayName": "Tokenwatch",
  "description": "Live Claude Code quota in your status bar: 5-hour session and weekly usage with reset countdowns.",
  "version": "0.3.0",
  "publisher": "kabartay",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1C1F26",
    "theme": "dark"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kabartay/tokenwatch.git"
  },
  "bugs": {
    "url": "https://github.com/kabartay/tokenwatch/issues"
  },
  "homepage": "https://github.com/kabartay/tokenwatch#readme",
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "quota",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenwatch.refresh",
        "title": "Refresh Claude Usage",
        "category": "Tokenwatch",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenwatch.showLog",
        "title": "Show Log",
        "category": "Tokenwatch",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Tokenwatch",
      "properties": {
        "tokenwatch.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "markdownDescription": "Seconds between automatic refreshes. Windows that are not focused skip polls and catch up when focused."
        },
        "tokenwatch.warnThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "The status bar turns amber when either quota reaches this percentage, or when at the current pace a quota will run out within the hour. It turns red at 100%."
        },
        "tokenwatch.statusBarStyle": {
          "type": "string",
          "enum": [
            "bars",
            "compact"
          ],
          "enumDescriptions": [
            "5h ▰▱▱▱▱ 9% · wk ▰▰▱▱▱ 41%",
            "5h 9% · wk 41%"
          ],
          "default": "bars",
          "markdownDescription": "How usage appears in the status bar."
        },
        "tokenwatch.showResetCountdown": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show when the 5-hour session resets, for example `↻4h 8m`, in the status bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:coverage": "npm run compile && node --test --experimental-test-coverage --test-coverage-exclude=\"out/test/**\" \"out/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "vsce package",
    "vscode:prepublish": "rm -rf out && npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  }
}
